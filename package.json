{
  "name": "oxxo_youtube",
  "version": "1.4.2",
  "private": true,
  "proxy": "http://localhost:3000",
  "main": "electron/main.cjs",
  "author": "OxxO",
  "description": "Desktop app for translation of youtube",
  "dependencies": {
    "@ant-design/icons": "^6.0.1",
    "@reduxjs/toolkit": "^2.9.0",
    "antd": "^5.27.3",
    "axios": "^1.11.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "electron-squirrel-startup": "^1.0.1",
    "es-hangul": "^2.3.8",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "fluent-ffmpeg": "^2.1.3",
    "i18next": "^22.5.1",
    "jspdf": "^3.0.3",
    "lodash": "^4.17.21",
    "lowdb": "^2.1.0",
    "marked-react": "^3.0.1",
    "mecab-async": "^0.1.2",
    "nanoid": "^5.1.5",
    "nodejs-whisper": "^0.2.9",
    "nodemon": "^3.1.10",
    "openai": "^5.19.1",
    "patch-package": "^8.0.1",
    "rc-virtual-list": "^3.19.2",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-hotkeys-hook": "^5.1.0",
    "react-i18next": "^12.0.0",
    "react-player": "^3.3.2",
    "react-redux": "^9.2.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.8.2",
    "redux": "^5.0.1",
    "sass": "^1.92.1",
    "uuid": "^12.0.0",
    "web-vitals": "^2.1.4",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "youtubei.js": "^16.0.1",
    "yt-dlp-wrap": "^2.3.12",
    "zod": "^3.25.76"
  },
  "scripts": {
    "server": "tsc ./server/Router/core/db_module.ts && nodemon ./server/server.js",
    "client": "react-scripts start",
    "start": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "serve": "concurrently --kill-others-on-fail \"npm run server\" \"serve -s build\" \"start http://localhost:3000\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "patch-package",
    "electron": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-octal-escape": 0
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "server/Asset"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-wix": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^27.5.1",
    "react-scripts": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
